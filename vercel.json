{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/app-ads\\.txt$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/app-ads.txt",
      "headers": { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "public, max-age=300" }
    },
    {
      "src": "^/\\.well-known/assetlinks\\.json$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/assetlinks.json",
      "headers": { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "public, max-age=300" }
    },
    {
      "src": "^/[a-fA-F0-9]{24}/?$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "status": 302,
      "headers": { "Location": "https://play.google.com/store/apps/details?id=com.doxibox", "Cache-Control": "no-store" }
    },
    {
      "src": "^/drama/[a-fA-F0-9]{24}(/[^/]+)?/?$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "status": 302,
      "headers": { "Location": "https://play.google.com/store/apps/details?id=com.doxibox", "Cache-Control": "no-store" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/home",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "^/(features|about|faq|contact)/?$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/$1",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "^/policy/?$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/policy",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "^/terms/?$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/terms",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "^/doxibox/(theme\\.css|policy\\.css|site\\.css|site\\.js|terms\\.css|favicon\\.svg|social-card\\.png)$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/$1"
    },
    {
      "src": "^/robots\\.txt$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/robots.txt"
    },
    {
      "src": "^/sitemap\\.xml$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/sitemap.xml",
      "headers": { "Content-Type": "application/xml; charset=utf-8" }
    },
    {
      "src": "^/.*$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/404.html",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, follow" }
    }
  ]
}
