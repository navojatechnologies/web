{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/home",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "^/(features|about|faq|contact)/?$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/$1",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "^/policy/?$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/policy",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    },
    {
      "src": "^/doxibox/(policy\\.css|site\\.css|site\\.js|favicon\\.svg|social-card\\.png)$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/$1"
    },
    {
      "src": "^/robots\\.txt$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/robots.txt"
    },
    {
      "src": "^/sitemap\\.xml$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/sitemap.xml",
      "headers": { "Content-Type": "application/xml; charset=utf-8" }
    },
    {
      "src": "^/.*$",
      "has": [{ "type": "host", "value": "doxibox.navojatech.com" }],
      "dest": "/doxibox/404.html",
      "status": 404,
      "headers": { "X-Robots-Tag": "noindex, follow" }
    }
  ]
}
